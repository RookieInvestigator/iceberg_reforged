  <div class="bg-top-glow"></div>
</div>

<script is:inline>
(function(){
  var el = document.getElementById('iceberg-bg');
  if (!el) return;
  var h = Math.max(document.documentElement.scrollHeight, el.getBoundingClientRect().height);
  el.style.setProperty('--bg-hf', Math.max(h / 1000, 1));

  var tid;
  function pauseBg() {
    el.classList.add('paused');
    clearTimeout(tid);
    tid = setTimeout(function() { el.classList.remove('paused'); }, 200);
  }
  window.addEventListener('scroll', pauseBg, { passive: true });
})();
</script>
