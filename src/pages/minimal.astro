---
// 简洁模式 — 原生滚动条，无 Hero
import BaseLayout from '../components/BaseLayout.astro';
import IcebergApp from '../components/IcebergApp.vue';
import TierNav from '../components/TierNav.vue';
import StaticHeader from '../components/StaticHeader.vue';
import Footer from '../components/Footer.astro';
import FooterModals from '../components/FooterModals.vue';
import { normalizeData } from '../lib/data';

const fs = await import('node:fs');
const raw = JSON.parse(fs.readFileSync('public/data/iceberg.json', 'utf-8'));
const data = normalizeData(raw);
const allItems = Object.values(data.tiers).flat();
---

<BaseLayout>
  <div class="relative w-full min-h-screen overflow-x-hidden bg-black">
    <div class="relative z-10 w-full mx-auto flex flex-col pt-20 pb-8 max-sm:pt-10 max-sm:pb-4 px-4" style="max-width: var(--max-width)">
      <StaticHeader client:only="vue" buildDate={data.generatedAt ? new Date(data.generatedAt * 1000).toLocaleDateString('zh-CN') : ''} entryCount={allItems.length} />

      <!-- 搜索 -->
      <div class="max-w-[500px] mx-auto mb-10">
      </div>

      <!-- 图例 + 交互 -->
      <div class="max-w-[900px] mx-auto mb-16 pb-10 border-b border-[#333]">
        <TierNav client:only="vue" tierOrder={data.tierOrder} />
        <IcebergApp client:only="vue"
          categories={JSON.stringify(Object.entries(data.categoryColors))}
          tags={JSON.stringify(Object.entries(data.tagMap))}
          allItems={JSON.stringify(allItems)}
          categoryColors={JSON.stringify(data.categoryColors)}
          tagMap={JSON.stringify(data.tagMap)}
          defaultColor={data.defaultColor}
        />
      </div>

      <!-- 1343 词条：静态 HTML -->
      <div id="items-container">
        {data.tierOrder.map((tierName, tierIndex) => (
          <section
            class="iceberg-tier relative bg-transparent min-h-[150px] flex flex-col py-10 overflow-visible z-[1] hover:z-[9999]"
            data-tier={tierName}
            style={`--tier-stagger: ${tierIndex};`}
          >
            <div class="relative z-[2] w-full">
              <h2 class="text-center font-black text-[0.85rem] text-white/40 tracking-[0.5em] mb-10 uppercase">{tierName}</h2>
              <div class="flex flex-wrap items-center justify-center gap-x-4 gap-y-3 max-sm:gap-x-1.5 max-sm:gap-y-1 max-sm:mb-3 px-[var(--header-padding-x)]">
                {(data.tiers[tierName] || []).map(item => (
                  <span
                    class="iceberg-item inline-flex items-center font-bold cursor-crosshair py-0.5 px-1.5 max-sm:text-[1.05rem]"
                    data-id={item.id}
                    data-category={item.category}
                    data-tags={item.tags.join(',')} data-tag-emojis={item.emojis.join(',')} data-has-link={item.link ? '1' : '0'} data-has-desc={item.desc ? '1' : '0'}
                    style={`font-size: 1.15em; color: ${item.categoryColor}; --item-color: ${item.categoryColor};`}
                  >
                    <span class="item-title transition-colors duration-200">{item.title}</span>
                    {item.emojis.map((e) => (
                      <span class="item-tag text-[0.5em] ml-[0.3em] relative -top-[0.08em] inline-flex items-center justify-center transition-colors duration-200">{e}</span>
                    ))}
                  </span>
                ))}
              </div>
            </div>
          </section>
        ))}
      </div>

      <!-- 页脚 -->
      <Footer>
        <FooterModals client:only="vue" buildDate={data.generatedAt ? new Date(data.generatedAt * 1000).toLocaleDateString('zh-CN') : ''} entryCount={allItems.length} />
      </Footer>
    </div>
  </div>
</BaseLayout>
